# ╔══════════════════════════════════════════════════╗
# ║   ZEN-Z COLLECTION — Environment Variables      ║
# ║   COPY this to .env and fill in your values     ║
# ╚══════════════════════════════════════════════════╝

# ── SERVER ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── DATABASE (MongoDB) ─────────────────────────────────
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/zenz-collection

# MongoDB Atlas (Cloud) - Uncomment and replace credentials
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/zenz-collection

# ── EMAIL (Gmail SMTP) ─────────────────────────────────
# Get App Password from: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
